<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE scanning requires a BLE-capable radio. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- USB host for the ESP32 companion. Not required: BLE-only use still works. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Android 12+ (API 31+) Bluetooth runtime permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Legacy Bluetooth permissions for Android 8.0 - 11 (API 26-30). Install-time, not runtime. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Location: required by Android to receive BLE scan results, and used for GPS tagging. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Phone WiFi access-point scan (optional third detection source). Both are install-time. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- Foreground service for continuous background scanning. The `location` type is what lets
         the fused provider keep delivering GPS fixes while the app UI is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Nothing leaves the phone via Google's cloud backup or device transfer: allowBackup=false
         for Android 8 - 11, data_extraction_rules (exclude everything) for 12+. The detections
         database is a GPS trace of surveillance hardware and the encrypted Maps key cannot be
         decrypted on another device anyway. Use Sessions > Back up… to move data. -->
    <application
        android:name=".BirdWatchApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BirdWatch">

        <!-- Filled at build time from BIRDWATCH_MAPS_KEY / keystore.properties (see
             app/build.gradle.kts); empty in builds without one, in which case MapsKeyInjector
             injects the key the user entered in Settings. Never write a literal key here. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <!-- singleTask: the USB_DEVICE_ATTACHED filter below would otherwise stack a second copy of
             the activity on top of a running one every time the ESP32 is plugged in. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BirdWatch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer to open the app (with USB permission pre-granted) when the ESP32 is plugged in. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <service
            android:name=".detection.ScanForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />

        <!-- Shares export files from cache/exports/ with the app the user picks in the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
